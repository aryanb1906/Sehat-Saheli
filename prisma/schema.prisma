generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MOTHER
  ASHA
  DOCTOR
}

enum ConsultationStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum LabStatus {
  NORMAL
  ALERT
  CRITICAL
}

enum ReferralStatus {
  GENERATED
  SHARED
  IN_TREATMENT
  COMPLETED
  BREACHED
}

enum ConsentAction {
  UPDATED
  REVOKED
}

model User {
  id            String              @id @default(cuid())
  name          String
  email         String              @unique
  emailVerified DateTime?
  passwordHash  String?
  role          UserRole
  image         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model ChatRoom {
  id          String        @id @default(cuid())
  motherId    String
  doctorId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]

  @@unique([motherId, doctorId])
}

model ChatMessage {
  id          String    @id @default(cuid())
  roomId      String
  senderId    String
  content     String
  createdAt   DateTime  @default(now())
  room        ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model VideoConsultation {
  id            String             @id @default(cuid())
  patientId     String
  doctorId      String?
  doctorName    String
  specialization String
  date          String
  time          String
  duration      Int                @default(30)
  reason        String?
  status        ConsultationStatus @default(SCHEDULED)
  roomId        String?
  notes         String?
  rating        Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([patientId, date])
}

model PatientProfile {
  id                String               @id @default(cuid())
  userId            String?
  ashaWorkerId      String
  name              String
  age               Int
  weeks             Int
  risk              RiskLevel
  lastCheckup       String
  phone             String
  village           String
  bloodPressure     String
  hemoglobin        Float
  weight            Float
  symptoms          Json
  nextAppointment   String?
  mentalHealthScore Int?
  emergencyContact  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  healthLogs        PatientHealthLog[]
  appointments      PatientAppointment[]
  tasks             AshaTask[]
  labReports        LabReport[]

  @@index([ashaWorkerId, risk])
}

model PatientHealthLog {
  id          String         @id @default(cuid())
  patientId   String
  date        String
  symptoms    Json
  mood        String
  notes       String
  bloodPressure String?
  weight      Float?
  createdAt   DateTime       @default(now())
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, date])
}

model PatientAppointment {
  id         String         @id @default(cuid())
  patientId  String
  date       String
  time       String
  type       String
  location   String
  status     String
  notes      String?
  createdAt  DateTime       @default(now())
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, date])
}

model AshaTask {
  id          String         @id @default(cuid())
  ashId       String
  patientId   String
  taskType    String
  description String
  dueDate     String
  status      TaskStatus     @default(PENDING)
  priority    TaskPriority   @default(MEDIUM)
  location    String?
  notes       String?
  completedAt String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([ashId, status])
}

model LabReport {
  id          String         @id @default(cuid())
  patientId   String
  date        String
  testType    String
  results     Json
  status      LabStatus      @default(NORMAL)
  imageUrl    String?
  doctorNotes String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Referral {
  id              String         @id @default(cuid())
  patientId       String
  consultationId  String
  note            String
  status          ReferralStatus @default(GENERATED)
  slaDeadline     DateTime?
  breachedAt      DateTime?
  matchedFacility String?
  capacityScore   Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([patientId, createdAt])
  @@index([status, slaDeadline])
}

model PrivacyConsent {
  userId             String          @id
  consentDataShare   Boolean
  consentAiTraining  Boolean
  retentionDays      Int
  version            Int             @default(1)
  revokedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  history            ConsentHistory[]
}

model ConsentHistory {
  id                String        @id @default(cuid())
  userId            String
  version           Int
  consentDataShare  Boolean
  consentAiTraining Boolean
  retentionDays     Int
  action            ConsentAction @default(UPDATED)
  actorId           String?
  createdAt         DateTime      @default(now())
  consent           PrivacyConsent @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  actorRole  String
  actorId    String?
  action     String
  resource   String
  endpoint   String?
  requestId  String?
  latencyMs  Int?
  statusCode Int?
  metadata   Json?

  @@index([timestamp])
  @@index([actorRole, timestamp])
  @@index([action, timestamp])
}

model IdempotencyRecord {
  key        String   @id
  userId     String
  endpoint   String
  method     String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([userId, endpoint])
  @@index([expiresAt])
}
